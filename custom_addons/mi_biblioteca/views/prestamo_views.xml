<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="prestamo_view_list" model="ir.ui.view">
    <field name="name">biblioteca.prestamo.list</field>
    <field name="model">biblioteca.prestamo</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="libro_id"/>
        <field name="socio_id"/>
        <field name="fecha_prestamo"/>
        <field name="estado"/>
      </list>
    </field>
  </record>

  <record id="prestamo_view_form" model="ir.ui.view">
    <field name="name">biblioteca.prestamo.form</field>
    <field name="model">biblioteca.prestamo</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_prestar" string="Prestar Libro" type="object" class="oe_highlight" invisible="estado != 'borrador'"/>
          <button name="action_devolver" string="Devolver Libro" type="object" class="oe_highlight" invisible="estado != 'prestado'"/>
          <field name="estado" widget="statusbar" statusbar_visible="borrador,prestado,devuelto"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="libro_id"/>
              <field name="socio_id"/>
            </group>
            <group>
              <field name="fecha_prestamo"/>
              <field name="dias"/>
              <field name="fecha_devolucion"/>
              <field name="retraso" invisible="not retraso"/>
              <field name="dias_retraso" invisible="not retraso"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- SEARCH VIEW -->
  <record id="prestamo_view_search" model="ir.ui.view">
    <field name="name">biblioteca.prestamo.search</field>
    <field name="model">biblioteca.prestamo</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="libro_id"/>
        <field name="socio_id"/>
        <filter name="filter_retrasados" string="Retrasados" domain="[('retraso', '=', True)]"/>
        <filter name="filtro_prestados" string="Prestados" domain="[('estado', '=', 'prestado')]"/>
        <separator/>
        
          <filter name="group_socio" string="Socio" context="{'group_by': 'socio_id'}"/>
          <filter name="group_libro" string="Libro" context="{'group_by': 'libro_id'}"/>
          <filter name="group_estado" string="Estado" context="{'group_by': 'estado'}"/>
        
      </search>
    </field>
  </record>

  <!-- ACTION -->
  <record id="prestamo_action" model="ir.actions.act_window">
    <field name="name">Préstamos</field>
    <field name="res_model">biblioteca.prestamo</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_filtro_prestados': 1}</field>
  </record>

  <menuitem id="menu_prestamos" name="Préstamos" parent="menu_biblioteca" action="prestamo_action" sequence="20"/>
</odoo>